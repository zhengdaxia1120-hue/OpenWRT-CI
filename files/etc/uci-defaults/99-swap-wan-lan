#!/bin/sh
# 小米 AX3600：lan1 改为 WAN，原 WAN 口并入 LAN 桥 br-lan

# 按 name 查找 br-lan 对应的 device 段，不依赖序号
idx=0
found=""
while uci -q get "network.@device[$idx]" >/dev/null 2>&1; do
    if [ "$(uci -q get "network.@device[$idx].name")" = "br-lan" ]; then
        found=1
        break
    fi
    idx=$((idx + 1))
done

if [ -z "$found" ]; then
    logger -t swap-wan-lan "未找到 br-lan 设备段，跳过"
    exit 0
fi

# 重建 br-lan 端口：lan2、lan3、原 WAN 口
uci -q delete "network.@device[$idx].ports"
uci add_list "network.@device[$idx].ports=lan2"
uci add_list "network.@device[$idx].ports=lan3"
uci add_list "network.@device[$idx].ports=wan"

# lan1 作为 WAN 的物理口
uci set network.wan.device='lan1'

# wan6 不一定存在，存在才修改
if uci -q get network.wan6 >/dev/null; then
    uci set network.wan6.device='lan1'
fi

uci commit network
exit 0
