#!/bin/sh
# WAN 拨号成功后，等 IPv6 就绪，再启动 DDNS（服务本身保持禁用）
[ "$ACTION" = "ifup" ] || exit 0
case "$INTERFACE" in
    wan|wan6) ;;
    *) exit 0 ;;
esac
(
    for i in $(seq 1 60); do
        ip -6 addr show dev pppoe-wan scope global | grep -q inet6 && break
        ip -4 addr show dev pppoe-wan scope global | grep -q inet && break
        sleep 5
    done
    sleep 10
    /etc/init.d/ddns restart
) &
